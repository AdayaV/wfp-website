---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const siteRoot = 'https://adayav.github.io/wfp-website/';

const navigation = [
  { label: 'ホーム', href: siteRoot },
  { label: 'ニュース', href: `${siteRoot}news/` },
  { label: 'チーム', href: `${siteRoot}team/` },
  { label: 'マシン', href: `${siteRoot}machine/` },
  { label: 'スポンサー', href: `${siteRoot}sponsors/` },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`WFP ウェブサイト構成案：${title}`} />
    <title>{title} | WFP 構成案</title>
  </head>
  <body>
    <header>
      <a href={siteRoot}>WFP</a>
      <nav aria-label="メインナビゲーション">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
