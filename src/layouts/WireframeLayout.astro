---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navigation = [
  { label: 'ホーム', href: base },
  { label: 'ニュース', href: `${base}news/` },
  { label: 'チーム', href: `${base}team/` },
  { label: 'マシン', href: `${base}machine/` },
  { label: 'スポンサー', href: `${base}sponsors/` },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`WFP ウェブサイト構成案：${title}`} />
    <title>{title} | WFP 構成案</title>
  </head>
  <body>
    <header>
      <a href={base}>WFP</a>
      <nav aria-label="メインナビゲーション">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
