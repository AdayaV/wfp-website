---
import WireframeLayout from '../layouts/WireframeLayout.astro';
import { newsArticles } from '../data/news';
import { scheduleItems } from '../data/schedule';

const siteRoot = 'https://adayav.github.io/wfp-website/';
const stories = newsArticles.length ? newsArticles.slice(0, 4) : [
  { title: 'ニュース記事 01', category: 'TEAM', href: siteRoot + 'news/', publishedAt: 'TBD' },
  { title: 'ニュース記事 02', category: 'DEVELOPMENT', href: siteRoot + 'news/', publishedAt: 'TBD' },
  { title: 'ニュース記事 03', category: 'EVENT', href: siteRoot + 'news/', publishedAt: 'TBD' },
  { title: 'ニュース記事 04', category: 'SPONSOR', href: siteRoot + 'news/', publishedAt: 'TBD' },
];
const events = scheduleItems.length ? scheduleItems : [
  { date: 'TBD', title: 'DESIGN CHECKPOINT', phase: 'DEVELOPMENT' },
  { date: 'TBD', title: 'MACHINE CHECKPOINT 01', phase: 'DEVELOPMENT' },
  { date: 'TBD', title: 'NEXT TEST RUN', phase: 'TEST', isNext: true },
  { date: 'TBD', title: 'MACHINE CHECKPOINT 02', phase: 'DEVELOPMENT' },
  { date: 'TBD', title: 'TEST RUN 02', phase: 'TEST' },
  { date: 'TBD', title: 'FORMULA SAE JAPAN', phase: 'EVENT' },
];
---

<WireframeLayout title="ホーム">
  <section class="home-lead" aria-labelledby="lead-news-title">
    <div class="home-lead-media" aria-hidden="true">MAIN NEWS IMAGE</div>
    <div class="home-lead-copy">
      <p class="section-label">{stories[0].category} / LATEST NEWS</p>
      <h1 id="lead-news-title">{stories[0].title}</h1>
      <a class="home-arrow-link" href={stories[0].href} aria-label="記事を見る">↗</a>
    </div>
    <div class="home-lead-controls" aria-label="メインニュースを移動">
      <button type="button" aria-label="前のニュース">←</button><button type="button" aria-label="次のニュース">→</button>
    </div>
    <ol class="home-lead-stories">
      {stories.map((story, index) => (
        <li><a href={story.href} aria-current={index === 0 ? 'true' : undefined}>
          <span>0{index + 1}</span><small>{story.category}</small><strong>{story.title}</strong>
        </a></li>
      ))}
    </ol>
  </section>

  <section class="home-latest" aria-labelledby="latest-news-heading">
    <header class="home-block-heading">
      <div><p class="section-label">LATEST NEWS</p><h2 id="latest-news-heading">WFP NEWS</h2></div>
      <div class="home-small-controls" aria-label="最新ニュースを移動">
        <button type="button" aria-label="前のニュース">←</button><button type="button" aria-label="次のニュース">→</button>
      </div>
    </header>
    <div class="home-latest-layout">
      <div class="home-latest-media" aria-hidden="true">NEWS IMAGE</div>
      <ol class="home-latest-list">
        {stories.map((story, index) => (
          <li><a href={story.href}>
            <span class="home-latest-number">0{index + 1}</span>
            <div><small>{story.category} · {story.publishedAt}</small><strong>{story.title}</strong><p>記事の概要が入るスペースです。</p></div>
            <span aria-hidden="true">↗</span>
          </a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-roadmap" aria-labelledby="roadmap-heading">
    <header class="home-roadmap-heading">
      <div><p class="section-label">ROAD TO FSAEJ</p><h2 id="roadmap-heading">大会までのスケジュール</h2></div>
      <div class="home-roadmap-controls" aria-label="予定を移動">
        <button type="button" data-roadmap-direction="-1" aria-label="前の予定">←</button><button type="button" data-roadmap-direction="1" aria-label="次の予定">→</button>
      </div>
    </header>
    <div class="home-roadmap-track" data-roadmap-track>
      {events.map((event) => (
        <article class="home-roadmap-card" aria-current={event.isNext ? 'date' : undefined}>
          <div class="home-roadmap-meta"><p>{event.date}</p><span>{event.phase}</span></div>
          <h3>{event.title}</h3>
          <div class="home-roadmap-image" aria-hidden="true">EVENT IMAGE</div>
          {event.isNext && <a href={siteRoot + 'schedule/'}>予定を見る →</a>}
        </article>
      ))}
    </div>
    <a class="home-roadmap-all" href={siteRoot + 'schedule/'}>全予定を見る</a>
  </section>

  <script>
    function setupRoadmap() {
      const track = document.querySelector('[data-roadmap-track]');
      if (!(track instanceof HTMLElement)) return;
      const cards = Array.from(track.querySelectorAll('.home-roadmap-card'));
      let current = Math.max(0, cards.findIndex((card) => card.getAttribute('aria-current') === 'date'));
      const show = (index, behavior = 'smooth') => {
        current = Math.max(0, Math.min(cards.length - 1, index));
        cards[current]?.scrollIntoView({ behavior, inline: 'center', block: 'nearest' });
      };
      document.querySelectorAll('[data-roadmap-direction]').forEach((button) => {
        button.addEventListener('click', () => show(current + Number(button.getAttribute('data-roadmap-direction'))));
      });
      const centerInitial = () => window.setTimeout(() => show(current, 'auto'), 150);
      if (document.readyState === 'complete') centerInitial();
      else window.addEventListener('load', centerInitial, { once: true });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupRoadmap, { once: true });
    else setupRoadmap();
  </script>
</WireframeLayout>
