---
import WireframeLayout from '../layouts/WireframeLayout.astro';

const siteRoot = 'https://adayav.github.io/wfp-website/';
const pages = [
  { label: 'ニュース', href: siteRoot + 'news/' },
  { label: 'チーム', href: siteRoot + 'team/' },
  { label: 'マシン', href: siteRoot + 'machine/' },
  { label: 'スポンサー', href: siteRoot + 'sponsors/' },
];
---

<WireframeLayout title="ホーム">
  <h1>ホーム</h1>
  <p>ページ一覧</p>
  <ul>
    {pages.map((page) => <li><a class="button" href={page.href}>{page.label}</a></li>)}
  </ul>
</WireframeLayout>
