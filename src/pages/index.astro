---
import WireframeLayout from '../layouts/WireframeLayout.astro';

const siteRoot = 'https://adayav.github.io/wfp-website/';
const stories = [
  { title: 'ニュース記事 01', href: siteRoot + 'news/' },
  { title: 'ニュース記事 02', href: siteRoot + 'news/' },
  { title: 'ニュース記事 03', href: siteRoot + 'news/' },
  { title: 'ニュース記事 04', href: siteRoot + 'news/' },
];
---

<WireframeLayout title="ホーム">
  <section class="news-hero">
    <div class="news-hero-media" aria-hidden="true">
      <span>FEATURE IMAGE</span>
    </div>
    <div class="news-hero-content">
      <p class="section-label">LATEST NEWS</p>
      <h1>{stories[0].title}</h1>
      <a class="button button-light" href={stories[0].href}>ニュースを見る</a>
    </div>
    <ol class="story-selector">
      {stories.map((story, index) => (
        <li>
          <a href={story.href}>
            <span>0{index + 1}</span>
            <p class="section-label">NEWS</p>
            <strong>{story.title}</strong>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="up-next">
    <div class="section-heading">
      <p class="section-label">UP NEXT</p>
      <h2>FSAEJ に向けた予定</h2>
    </div>
    <div class="schedule-preview">
      <div><span>TBD</span><strong>TEST RUN</strong></div>
      <div><span>TBD</span><strong>MACHINE CHECKPOINT</strong></div>
      <div><span>TBD</span><strong>FSAEJ</strong></div>
    </div>
    <a class="button" href={siteRoot + 'schedule/'}>スケジュールを見る</a>
  </section>
</WireframeLayout>
