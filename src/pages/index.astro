---
import WireframeLayout from '../layouts/WireframeLayout.astro';
import { getNewsArticles } from '../data/news';
import { getScheduleItems } from '../data/schedule';
import { getSponsorTiers } from '../data/sponsors';

const siteRoot = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const stories = (await getNewsArticles()).slice(0, 4);
const storySlots = Array.from({ length: 4 }, (_, index) => stories[index]);
const leadStory = stories[0];
const sponsorTiers = await getSponsorTiers();
const platinumSponsors = sponsorTiers.find((tier) => tier.id === 'platinum')?.sponsors ?? [];
const scheduleItems = await getScheduleItems();
const calendarItems = scheduleItems;
---

<WireframeLayout title="ホーム">
  <section class:list={['home-lead', { 'home-lead--empty': !leadStory }]} aria-label="最新ニュース" data-hero>
    {leadStory ? stories.map((story, index) => (
      <article class="home-lead-slide" data-hero-slide={index} aria-hidden={index === 0 ? 'false' : 'true'}>
        <div class="home-lead-media" aria-hidden="true">
          {story.image && <img src={story.image} alt="" />}
        </div>
        <div class="home-lead-copy">
          <a class="home-lead-article-link" href={story.href} aria-label={`${story.title}の記事を見る`}>
            <p class="section-label">{story.category} / LATEST NEWS</p>
            <h1 id={index === 0 ? 'lead-news-title' : undefined}>{story.title}</h1>
            <span class="home-arrow-link" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    )) : (
      <>
        <div class="home-lead-media" aria-hidden="true"></div>
        <div class="home-lead-copy">
          <p class="section-label">WASEDA FORMULA PROJECT</p>
          <h1 id="lead-news-title">WFP</h1>
        </div>
      </>
    )}
    {leadStory && (
      <>
        {stories.length > 1 && (
          <div class="home-lead-controls" aria-label="メインニュースを移動">
            <button type="button" data-hero-direction="-1" aria-label="前のニュース">←</button><button type="button" data-hero-direction="1" aria-label="次のニュース">→</button>
          </div>
        )}
        <ol class="home-lead-stories">
          {storySlots.map((story, index) => (
            <li class:list={{ 'is-coming-soon': !story }}>
              {story ? (
                <button type="button" data-hero-select={index} aria-current={index === 0 ? 'true' : undefined}>
                  <span>0{index + 1}</span><small>{story.category}</small><strong>{story.title}</strong>
                </button>
              ) : (
                <div class="home-lead-story-placeholder">
                  <span>0{index + 1}</span><small>COMING SOON</small><strong>次のニュースをお待ちください</strong>
                </div>
              )}
            </li>
          ))}
        </ol>
      </>
    )}
  </section>

  <section class="home-roadmap" aria-labelledby="roadmap-heading">
    <header class="home-roadmap-heading">
      <div>
        <p class="section-label">ROAD TO FSAEJ 2027</p>
        <h2 id="roadmap-heading">大会までのスケジュール</h2>
      </div>
      <div class="home-roadmap-countdown" data-countdown data-target="2027-08-23T00:00:00+09:00" aria-label="2027年大会までのカウントダウン">
        <div><strong data-countdown-days>000</strong><span>DAYS</span></div>
        <div><strong data-countdown-hours>00</strong><span>HOURS</span></div>
        <div><strong data-countdown-minutes>00</strong><span>MIN</span></div>
        <div><strong data-countdown-seconds>00</strong><span>SEC</span></div>
      </div>
    </header>
    {calendarItems.length ? (
      <>
        <div class="home-roadmap-track" data-drag-scroll>
          {calendarItems.map((event, index) => (
            <article class="home-roadmap-card" aria-current={event.isNext ? 'date' : undefined}>
              <div class="home-roadmap-visual" aria-hidden="true">
                {event.image && <img src={event.image} alt="" />}
                <span>0{index + 1}</span>
              </div>
              <div class="home-roadmap-card-copy">
                <div class="home-roadmap-meta"><p>{event.date}</p><span>{event.phase}</span></div>
                <h3>{event.title}</h3>
                {event.location && <p class="home-roadmap-location">{event.location}</p>}
              </div>
            </article>
          ))}
        </div>
        <a class="home-roadmap-all" href={siteRoot + 'schedule/'}>全予定を見る <span aria-hidden="true">↗</span></a>
      </>
    ) : (
      <div class="home-roadmap-empty">
        <p class="section-label">COMING SOON</p>
        <p>スケジュールは公開準備中です。</p>
      </div>
    )}
  </section>

  <section class="home-latest" aria-labelledby="latest-news-heading">
    <header class="home-block-heading">
      <div><p class="section-label">LATEST NEWS</p><h2 id="latest-news-heading">WFP NEWS</h2></div>
      <a class="home-latest-all" href={siteRoot + 'news/'}>ニュース一覧 <span aria-hidden="true">↗</span></a>
    </header>
    {stories.length ? (
      <div class="home-latest-layout">
        <a class="home-latest-media" href={leadStory.href} aria-label={leadStory.title} data-latest-media>
          {leadStory.image && <img src={leadStory.image} alt="" data-latest-image />}
        </a>
        <ol class="home-latest-list">
          {storySlots.map((story, index) => (
            <li class:list={{ 'is-coming-soon': !story }}>
              {story ? (
                <a href={story.href} data-latest-story data-image={story.image || ''} data-title={story.title}>
                  <div><strong>{story.title}</strong><p>{story.summary}</p><small class="mobile-news-count">0{index + 1} / 04</small></div>
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <div class="home-latest-placeholder">
                  <span class="home-latest-number">0{index + 1}</span>
                  <div><small>COMING SOON</small><strong>次のニュースをお待ちください</strong></div>
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="home-latest-empty">
        <p class="section-label">COMING SOON</p>
        <p>ニュースは公開準備中です。</p>
      </div>
    )}
  </section>

  <section class="home-section home-section--split" aria-labelledby="home-team-heading">
    <header class="home-section-heading">
      <p class="section-label">TEAM</p>
      <h2 id="home-team-heading">Waseda Formula Project</h2>
    </header>
    <div class="home-section-copy">
      <p>学生が自らフォーミュラカーを設計・製作し、学生フォーミュラ日本大会に挑む早稲田大学のチームです。</p>
      <a class="button" href={siteRoot + 'team/'}>チームを見る</a>
    </div>
  </section>

  <section class="home-section home-section--split" aria-labelledby="home-machine-heading">
    <header class="home-section-heading">
      <p class="section-label">MACHINE</p>
      <h2 id="home-machine-heading">2027年度マシン</h2>
    </header>
    <div class="home-section-copy">
      <p>設計、製作、走行検証を通して、次の大会に向けたマシン開発を進めています。</p>
      <a class="button" href={siteRoot + 'machine/'}>マシンを見る</a>
    </div>
  </section>

  <section class="home-section home-sponsors" aria-labelledby="home-sponsors-heading">
    <header class="home-section-heading home-section-heading--row">
      <div><p class="section-label">PLATINUM PARTNERS</p><h2 id="home-sponsors-heading">プラチナスポンサー</h2></div>
      <a class="button" href={siteRoot + 'sponsors/'}>すべて見る</a>
    </header>
    <ul class="home-sponsor-grid">
      {platinumSponsors.map((sponsor) => (
        <li>
          {sponsor.website ? (
            <a href={sponsor.website} target="_blank" rel="noreferrer">
              {sponsor.logo && <img src={sponsor.logo} alt={sponsor.logoAlt || sponsor.name} />}
              {!sponsor.logo && <strong>{sponsor.name}</strong>}
            </a>
          ) : (
            <>
              {sponsor.logo && <img src={sponsor.logo} alt={sponsor.logoAlt || sponsor.name} />}
              {!sponsor.logo && <strong>{sponsor.name}</strong>}
            </>
          )}
        </li>
      ))}
    </ul>
  </section>

  <script>
    function setupHero() {
      const hero = document.querySelector('[data-hero]');
      if (!(hero instanceof HTMLElement)) return;
      const slides = Array.from(hero.querySelectorAll('[data-hero-slide]'));
      const selectors = Array.from(hero.querySelectorAll('[data-hero-select]'));
      if (!slides.length) return;
      let current = 0;
      const show = (next) => {
        current = (next + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          slide.setAttribute('aria-hidden', String(index !== current));
          if (slide instanceof HTMLElement) slide.inert = index !== current;
        });
        selectors.forEach((selector, index) => {
          if (index === current) selector.setAttribute('aria-current', 'true');
          else selector.removeAttribute('aria-current');
        });
      };
      selectors.forEach((selector, index) => selector.addEventListener('click', () => show(index)));
      hero.querySelectorAll('[data-hero-direction]').forEach((button) => {
        button.addEventListener('click', () => show(current + Number(button.getAttribute('data-hero-direction'))));
      });
      show(0);
    }

    function setupDragScroll() {
      document.querySelectorAll('[data-drag-scroll]').forEach((track) => {
        if (!(track instanceof HTMLElement)) return;
        let startX = 0;
        let startScroll = 0;
        let dragging = false;
        track.addEventListener('pointerdown', (event) => {
          if (!(event instanceof PointerEvent) || event.pointerType === 'touch') return;
          dragging = true;
          startX = event.clientX;
          startScroll = track.scrollLeft;
          track.setPointerCapture(event.pointerId);
          track.classList.add('is-dragging');
        });
        track.addEventListener('pointermove', (event) => {
          if (!dragging || !(event instanceof PointerEvent)) return;
          track.scrollLeft = startScroll - (event.clientX - startX);
        });
        const stop = () => {
          dragging = false;
          track.classList.remove('is-dragging');
        };
        track.addEventListener('pointerup', stop);
        track.addEventListener('pointercancel', stop);
      });
    }

    function setupRoadmapCarousel() {
      const track = document.querySelector('.home-roadmap-track');
      if (!(track instanceof HTMLElement)) return;
      const cards = Array.from(track.querySelectorAll('.home-roadmap-card'));
      let scheduled = false;
      const updateCurrent = () => {
        const trackCenter = track.getBoundingClientRect().left + track.clientWidth / 2;
        let closest = cards[0];
        let closestDistance = Number.POSITIVE_INFINITY;
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const distance = Math.abs(rect.left + rect.width / 2 - trackCenter);
          if (distance < closestDistance) {
            closest = card;
            closestDistance = distance;
          }
        });
        cards.forEach((card) => {
          if (card === closest) card.setAttribute('aria-current', 'date');
          else card.removeAttribute('aria-current');
        });
        scheduled = false;
      };
      track.addEventListener('scroll', () => {
        if (scheduled) return;
        scheduled = true;
        window.requestAnimationFrame(updateCurrent);
      }, { passive: true });
      const initial = cards.find((card) => card.getAttribute('aria-current') === 'date') ?? cards[0];
      window.setTimeout(() => {
        if (initial instanceof HTMLElement) {
          track.scrollLeft = initial.offsetLeft - (track.clientWidth - initial.clientWidth) / 2;
        }
        updateCurrent();
      }, 100);
    }

    function setupCountdown() {
      const countdown = document.querySelector('[data-countdown]');
      if (!(countdown instanceof HTMLElement)) return;
      const target = new Date(countdown.dataset.target ?? '').getTime();
      const days = countdown.querySelector('[data-countdown-days]');
      const hours = countdown.querySelector('[data-countdown-hours]');
      const minutes = countdown.querySelector('[data-countdown-minutes]');
      const seconds = countdown.querySelector('[data-countdown-seconds]');
      const update = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalSeconds = Math.floor(remaining / 1000);
        if (days) days.textContent = String(Math.floor(totalSeconds / 86400)).padStart(3, '0');
        if (hours) hours.textContent = String(Math.floor((totalSeconds % 86400) / 3600)).padStart(2, '0');
        if (minutes) minutes.textContent = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
        if (seconds) seconds.textContent = String(totalSeconds % 60).padStart(2, '0');
      };
      update();
      window.setInterval(update, 1000);
    }

    function setupLatestNewsPreview() {
      const media = document.querySelector('[data-latest-media]');
      if (!(media instanceof HTMLAnchorElement) || media.dataset.previewReady) return;
      media.dataset.previewReady = 'true';
      let image = media.querySelector('img') ?? document.createElement('img');
      media.append(image);

      const storyLinks = Array.from(document.querySelectorAll('[data-latest-story]'))
        .filter((story): story is HTMLAnchorElement => story instanceof HTMLAnchorElement);

      let transitionId = 0;

      const updateMedia = (story: HTMLAnchorElement, immediate = false) => {
        image = media.querySelector('img') ?? document.createElement('img');
        if (!image.isConnected) media.append(image);
        const nextImage = story.dataset.image;
        if (!nextImage) { media.replaceChildren(); }
        if (nextImage && immediate) {
          image.src = nextImage;
          image.alt = '';
        } else if (nextImage && nextImage !== image.src) {
          const currentTransition = ++transitionId;
          const previousImage = image;
          const incomingImage = image.cloneNode() as HTMLImageElement;
          incomingImage.src = nextImage;
          incomingImage.alt = '';
          incomingImage.removeAttribute('data-latest-image');
          incomingImage.classList.add('is-incoming');
          media.append(incomingImage);

          requestAnimationFrame(() => requestAnimationFrame(() => {
            previousImage.classList.add('is-leaving');
            incomingImage.classList.remove('is-incoming');
          }));

          window.setTimeout(() => {
            if (currentTransition !== transitionId) return;
            media.querySelectorAll('img').forEach((candidate) => {
              if (candidate !== incomingImage) candidate.remove();
            });
            incomingImage.setAttribute('data-latest-image', '');
            image = incomingImage;
          }, 420);
        }
        media.href = story.href;
        media.setAttribute('aria-label', story.dataset.title || '記事を見る');
      };

      const activateStory = (story: HTMLAnchorElement, immediate = false) => {
        if (matchMedia('(max-width: 700px)').matches) return;
        storyLinks.forEach((link) => link.removeAttribute('aria-current'));
        story.setAttribute('aria-current', 'true');

        updateMedia(story, immediate);
      };

      storyLinks.forEach((story) => {
        if (!(story instanceof HTMLAnchorElement)) return;
        story.addEventListener('mouseenter', () => activateStory(story));
        story.addEventListener('focus', () => activateStory(story));
      });

      if (storyLinks[0]) activateStory(storyLinks[0], true);
    }

    function setupMobileNews() {
      const track = document.querySelector<HTMLOListElement>('.home-latest-list');
      const media = document.querySelector<HTMLAnchorElement>('[data-latest-media]');
      if (!track || !media) return;
      const cards = Array.from(track.children) as HTMLElement[];
      const mobile = window.matchMedia('(max-width: 700px)');
      let current = -1;
      const sync = () => {
        if (!mobile.matches) return;
        const start = track.getBoundingClientRect().left;
        const index = cards.reduce((best, card, i) => Math.abs(card.getBoundingClientRect().left - start) < Math.abs(cards[best].getBoundingClientRect().left - start) ? i : best, 0);
        if (index === current) return;
        current = index;
        const story = cards[index].querySelector<HTMLAnchorElement>('[data-latest-story]');
        track.querySelectorAll('[data-latest-story]').forEach(link => link.removeAttribute('aria-current'));
        story?.setAttribute('aria-current', 'true');
        media.replaceChildren();
        if (story?.dataset.image) {
          const image = document.createElement('img'); image.src = story.dataset.image; image.alt = ''; media.append(image);
        }
        if (story) { media.href = story.href; media.setAttribute('aria-label', story.dataset.title || '記事を見る'); }
        else { media.removeAttribute('href'); media.setAttribute('aria-label', 'COMING SOON'); }
      };
      track.addEventListener('scroll', sync, { passive: true });
      let touchX = 0, touchY = 0, moved = false;
      media.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; touchY = e.touches[0].clientY; moved = false; }, { passive: true });
      media.addEventListener('touchend', e => {
        if (!mobile.matches) return;
        const dx = e.changedTouches[0].clientX - touchX, dy = e.changedTouches[0].clientY - touchY;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        moved = true;
        const next = Math.max(0, Math.min(cards.length - 1, current + (dx < 0 ? 1 : -1)));
        track.scrollBy({ left: cards[next].getBoundingClientRect().left - cards[current].getBoundingClientRect().left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      }, { passive: true });
      media.addEventListener('click', e => { if (moved) { e.preventDefault(); moved = false; } });
      mobile.addEventListener('change', () => { current = -1; if (mobile.matches) sync(); else { setupLatestNewsPreview(); track.querySelector<HTMLElement>('[data-latest-story]')?.dispatchEvent(new Event('mouseenter')); } });
      sync();
    }

    function setupHome() {
      setupHero();
      setupDragScroll();
      setupRoadmapCarousel();
      setupCountdown();
      if (!matchMedia('(max-width: 700px)').matches) setupLatestNewsPreview();
      setupMobileNews();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupHome, { once: true });
    else setupHome();
  </script>
</WireframeLayout>

