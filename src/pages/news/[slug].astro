---
import { render, type CollectionEntry } from 'astro:content';
import WireframeLayout from '../../layouts/WireframeLayout.astro';
import { getNewsEntries, newsAssetPath } from '../../data/news';

export async function getStaticPaths() {
  const entries = await getNewsEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const image = newsAssetPath(entry.data.image);
const publishedAtIso = entry.data.publishedAt.toISOString().slice(0, 10);
const publishedAt = publishedAtIso.replaceAll('-', '.');
const newsRoot = import.meta.env.BASE_URL + 'news/';
---

<WireframeLayout title={entry.data.title}>
  <article class="news-article">
    <header class="news-article-header">
      <p class="section-label">{entry.data.category} / <time datetime={publishedAtIso}>{publishedAt}</time></p>
      <h1>{entry.data.title}</h1>
      <p class="news-article-summary">{entry.data.summary}</p>
    </header>
    {image && <img class="news-article-hero" src={image} alt={entry.data.imageAlt} />}
    <div class="news-article-body">
      <Content />
    </div>
    <footer class="news-article-footer">
      <a href={newsRoot}>← ニュース一覧へ</a>---
