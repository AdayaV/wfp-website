---
import WireframeLayout from '../../layouts/WireframeLayout.astro';
import { getNewsEntries, type MicroCMSNewsEntry } from '../../data/news';

export async function getStaticPaths() {
  const entries = await getNewsEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: MicroCMSNewsEntry;
}

const { entry } = Astro.props;
const publishedAtIso = entry.publishedAt.slice(0, 10);
const publishedAt = publishedAtIso.replaceAll('-', '.');
const newsRoot = import.meta.env.BASE_URL + 'news/';
---

<WireframeLayout title={entry.title}>
  <article class="editorial-article">
    {entry.image ? (
      <figure class="editorial-article-hero">
        <img src={entry.image.url} alt={entry.imageAlt || ''} />
      </figure>
    ) : (
      <div class="editorial-article-hero editorial-article-hero--empty"><span>WFP NEWS</span></div>
    )}

    <div class="editorial-article-panel">
      <nav class="editorial-breadcrumbs" aria-label="パンくずリスト">
        <a href={newsRoot}>NEWS</a><span aria-hidden="true">›</span><span>{entry.category}</span>
      </nav>
      <p class="editorial-article-meta"><span aria-hidden="true"></span><time datetime={publishedAtIso}>{publishedAt}</time> / {entry.category}</p>
      <h1>{entry.title}</h1>
      <p class="editorial-article-summary">{entry.summary}</p>
    </div>

    <div class="editorial-article-layout">
      <aside class="editorial-article-side">
        <p class="section-label">WFP NEWS</p>
        <span>ARTICLE</span>
      </aside>
      <div class="news-article-body" set:html={entry.body}></div>
    </div>

    <footer class="news-article-footer">
      <a href={newsRoot}>← ニュース一覧へ戻る</a>
    </footer>
  </article>
</WireframeLayout>
