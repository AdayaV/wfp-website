---
import WireframeLayout from '../layouts/WireframeLayout.astro';
import { getTeamMembers } from '../data/members';

const members = await getTeamMembers();

// 2026年度の体制表を表示上の正とする。microCMS上で兼班を編集できる状態は
// 保ちつつ、誤登録によって別班のCHIEFが先頭に来ないよう班ごとに並びを定義する。
const groupRoster = [
  {
    title: 'チーム運営',
    names: ['大和田 龍', '佐々木 将博', '関 慶太', '平野 舜介', '小玉 耀介', '瀧澤 怜', '寺尾 智成', '中岡 嶺'],
    roles: { '大和田 龍': 'TEAM PRINCIPAL', '佐々木 将博': 'GENERAL MANAGER', '関 慶太': 'MANAGEMENT CHIEF', '平野 舜介': 'MANAGEMENT MANAGER', '小玉 耀介': 'ACCOUNTING' },
  },
  {
    title: 'パワートレイン班',
    names: ['関 慶太', '姫野 淳', '千原 丈', '藤原 光瑠', '狩野 貴裕', '中村 泰正', '足立 純也', '岡原 拓音', '小玉 耀介', '斉藤 瑠来', '佐々木 将博', '豊田 雄介', '吉田 峻太朗', '井上 脩', '袁 子熙', '瀧澤 怜', '竹ノ谷 美希'],
    roles: { '関 慶太': 'CHIEF', '姫野 淳': 'MANAGER' },
  },
  {
    title: 'サスペンション班',
    names: ['水戸 彩葉', '平井 伶於奈', '稲葉 摩人', '細井 敬哲', '藤原 光瑠', '山崎 嘉乃', '近藤 尚哉', '中村 泰正', '香村 純花', '佐々木 将博', '平野 舜介', '松本 真慧', '井上 建人', '袁 子熙', '鈴木 悠太', '田村 智道', '寺尾 智成', '二國 悠生', '根岸 倫弘'],
    roles: { '水戸 彩葉': 'CHIEF', '平井 伶於奈': 'MANAGER' },
  },
  {
    title: 'エアロ班',
    names: ['大和田 龍', '小林 悠真', '狩野 貴裕', '只野 陽向太', '大塚 海斗', '香村 純花', '豊田 雄介', '平井 伶於奈', '瀧澤 怜', '竹ノ谷 美希', '寺尾 智成', '中岡 嶺', '二國 悠生', '村松 由唯'],
    roles: { '大和田 龍': 'CHIEF', '小林 悠真': 'MANAGER' },
  },
  {
    title: 'フレーム班',
    names: ['近藤 尚哉', '斉藤 瑠来', '千原 丈', '大和田 龍', '只野 陽向太', '山崎 嘉乃', '水戸 彩葉', '足立 純也', '小玉 耀介', '小林 悠真', '佐々木 将博', '井上 建人', '鈴木 悠太', '田村 智道', '根岸 倫弘', '村松 由唯'],
    roles: { '近藤 尚哉': 'CHIEF', '斉藤 瑠来': 'MANAGER' },
  },
  { title: 'デザイン班', names: ['藤原 光瑠', '狩野 貴裕'], roles: { '藤原 光瑠': 'CHIEF', '狩野 貴裕': 'MANAGER' } },
  { title: 'コスト班', names: ['関 慶太', '大塚 海斗'], roles: { '関 慶太': 'CHIEF', '大塚 海斗': 'MANAGER' } },
  { title: 'プレゼン班', names: ['吉田 峻太朗'], roles: { '吉田 峻太朗': 'MANAGER' } },
  { title: 'PR班', names: ['小林 悠真', '中村 泰正', '足立 純也', '斉藤 瑠来', '佐々木 将博', '豊田 雄介', '吉田 峻太朗'], roles: {} },
];

const normalizeName = (name: string) => name.replace(/\s/g, '').replace(/[斎齋齊]/g, '斉');
const memberByName = new Map(members.map((member) => [normalizeName(member.name), member]));
const groups = groupRoster
  .map((group) => {
    const rosterNames = group.title === 'PR班'
      ? Array.from(new Map([
          ...group.names,
          ...members
            .filter((member) => [...member.divisions, ...member.units].includes('PR班'))
            .map((member) => member.name),
        ].map((name) => [normalizeName(name), name])).values())
      : group.names;
    return {
      title: group.title,
      members: rosterNames
      .map((name) => {
        const member = memberByName.get(normalizeName(name));
        const displayRole = group.roles[name as keyof typeof group.roles];
        const shouldDisplay = group.title === 'PR班' || Boolean(displayRole);
        return member && shouldDisplay ? { ...member, displayRole } : undefined;
      })
      .filter((member): member is (typeof members)[number] => Boolean(member)),
    };
  })
  .filter((group) => group.members.length > 0);
const teamMemberCount = members.length;
---

<WireframeLayout title="チーム">
  <div class="team-page">
    <header class="team-intro">
      <div><p class="section-label"><img src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'images/wfp_logo.svg'} alt="" />FORMULA SAE</p><h1><strong>WASEDA FORMULA</strong><strong>PROJECT</strong><span>TEAM</span></h1></div>
      <p>2009年の発足以来、早稲田大学の学生によるWaseda Formula Projectは、自らの手でフォーミュラカーをつくり、挑戦を重ねてきました。2011年の大会初出場から、完走、全種目完遂へ。受け継いだ技術と経験を力に、学生フォーミュラ日本大会でさらなる高みを目指します。<br /><br />設計・製作を担うメンバー、コースを走るドライバー、活動を支える運営・PR。役割は違っても、目指すのは同じ一台です。それぞれの知識と工夫、挑戦への情熱を持ち寄り、チームの力でマシンを前へ進めます。</p>
    </header>
    <section class="team-story-section" aria-labelledby="team-history-heading">
      <header class="team-story-heading"><p class="team-section-number">01</p><div><p class="section-label">OUR HISTORY</p><h2 id="team-history-heading">挑戦を、次の世代へ。</h2></div></header>
      <div class="team-story-body"><p>自動車部の学生フォーミュラ班としての活動を前身に、2009年、Waseda Formula Projectが発足。初出場から完走、全種目完遂へと、一歩ずつ経験を積み重ねてきました。先輩たちが残した技術と試行錯誤を受け継ぎ、次の一台へとつないでいます。</p>
        <ol class="team-history-list">
          <li><time>2009</time><div><h3>WFP発足</h3><p>Waseda Formula Projectとして、新たなスタートを切る。</p></div></li>
          <li><time>2011</time><div><h3>大会初出場</h3><p>WFPとして初めて学生フォーミュラの舞台へ。</p></div></li>
          <li><time>2013</time><div><h3>初のエンデュランス完走</h3><p>走り切る力を証明し、次の挑戦への足掛かりを築く。</p></div></li>
          <li><time>2016</time><div><h3>初の全種目完遂</h3><p>チームとして初めて全種目を完遂。総合17位を獲得。</p></div></li>
          <li><time>2019</time><div><h3>4年連続の全種目完遂</h3><p>継続的な開発と経験の蓄積により、総合16位を獲得。</p></div></li>
        </ol>
      </div>
    </section>
    <section class="team-story-section" aria-labelledby="team-formula-heading">
      <header class="team-story-heading"><p class="team-section-number">02</p><div><p class="section-label">FORMULA STUDENT</p><h2 id="team-formula-heading">速さの先にある、<br />ものづくりの総合力。</h2></div></header>
      <div class="team-story-body"><p>学生フォーミュラは、学生が自ら構想・設計・製作した車両で、ものづくりの総合力を競う競技です。コース上の速さだけでなく、設計の考え方、製造コスト、事業としての提案までが評価の対象。マシンをつくる力と、その価値を説明する力の両方が問われます。</p>
        <div class="team-formula-grid">
          <article><p class="section-label">INSPECTION</p><h3>車検</h3><p>車両が安全性やルールの要件を満たしているかを確認。走行による審査へ進むための最初の関門です。</p></article>
          <article><p class="section-label">STATIC EVENTS</p><h3>静的審査</h3><p>設計の妥当性、製造コスト、プレゼンテーションを通じて、開発の根拠と車両の価値を伝えます。</p></article>
          <article><p class="section-label">DYNAMIC EVENTS</p><h3>動的審査</h3><p>加速、旋回、周回走行などを通じて、マシンの運動性能や信頼性、効率を確かめます。</p></article>
        </div>
      </div>
    </section>
    <section class="team-organization" aria-labelledby="team-organization-heading">
      <header class="team-section-heading"><p class="team-section-number">03</p><div><p class="section-label">ORGANIZATION</p><h2 id="team-organization-heading">チーム体制</h2></div><p><strong>{teamMemberCount}</strong><span>MEMBERS</span></p></header>
      {teamMemberCount ? (
        <div class="team-divisions">
          {groups.map((group, groupIndex) => (
            <section class="team-division" aria-labelledby={`group-${groupIndex}`}>
              <header><p>{String(groupIndex + 1).padStart(2, '0')}</p><h3 id={`group-${groupIndex}`}>{group.title}</h3></header>
              <ul class="team-member-grid">
                {group.members.map((member) => (
                  <li>
                    {member.photo && (<div class="team-member-photo"><img src={member.photo} alt={`${member.name}のプロフィール写真`} /></div>)}
                    <div class="team-member-copy">
                      {member.displayRole && <p class="team-member-role">{member.displayRole}</p>}
                      <h4>{member.name}</h4>
                      {member.grade && <p class="team-member-grade">{member.grade}</p>}
                      {member.department && <p class="team-member-department">{member.department}</p>}
                      {member.units.length > 0 && (<ul class="team-member-units" aria-label="所属班">{member.units.map((unit) => <li>{unit}</li>)}</ul>)}
                      {member.profile && <p class="team-member-profile">{member.profile}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (<div class="team-empty"><p class="section-label">MEMBERS COMING SOON</p><p>メンバー情報はmicroCMSから追加できます。</p></div>)}
    </section>
  </div>
</WireframeLayout>

<style>
  .team-story-copy, .team-story-body { color: #bdbdbd; font-size: 16px; line-height: 1.9; }
  .team-story-copy p, .team-story-body > p { margin: 0 0 1.3em; }
  .team-story-copy p:last-child { margin-bottom: 0; }
  .team-story-copy .team-philosophy { color: #f4f4f4; font-weight: 700; }
  .team-story-section { padding: clamp(56px, 7vw, 100px) 0; border-top: 1px solid #333; }
  .team-story-heading { display: grid; grid-template-columns: clamp(70px, 8vw, 120px) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: start; margin-bottom: 36px; }
  .team-story-heading h2 { margin: 0; font-size: clamp(28px, 3.2vw, 44px); font-weight: 700; line-height: 1.3; letter-spacing: -.035em; }
  .team-story-body { margin-left: calc(clamp(70px, 8vw, 120px) + clamp(28px, 5vw, 80px)); }
  .team-story-body > p { max-width: 850px; }
  .team-history-list { list-style: none; padding: 0; margin: 36px 0 0; }
  .team-history-list li { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 24px; padding: 22px 0; border-top: 1px solid #333; }
  .team-history-list time { color: #cc7890; font-size: 24px; font-weight: 700; }
  .team-history-list h3, .team-formula-grid h3 { margin: 0 0 8px; color: #f4f4f4; font-size: 20px; font-weight: 700; line-height: 1.4; }
  .team-history-list p, .team-formula-grid article > p:last-child { margin: 0; }
  .team-formula-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 36px; }
  .team-formula-grid article { border-top: 3px solid #800020; padding-top: 20px; }
  .team-formula-grid .section-label { color: #aaa; }
  @media (max-width: 700px) {
    .team-story-copy { grid-column: 2; }
    .team-story-copy, .team-story-body { font-size: 15px; line-height: 1.8; }
    .team-story-heading { grid-template-columns: 54px minmax(0, 1fr); gap: 18px; }
    .team-story-body { margin-left: 0; }
    .team-history-list li { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; }
    .team-history-list time { font-size: 21px; }
    .team-formula-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

