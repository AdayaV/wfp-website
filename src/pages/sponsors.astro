---
import WireframeLayout from '../layouts/WireframeLayout.astro';
import { getSponsorTiers } from '../data/sponsors';

const sponsorTiers = await getSponsorTiers();
---

<WireframeLayout title="スポンサー">
  <section class="sponsors-page">
    <header class="sponsors-intro">
      <div class="sponsors-intro-title">
        <p class="section-label">WFP PARTNERS</p>
        <h1>スポンサー</h1>
      </div>
      <p class="sponsors-intro-copy">挑戦をともにし、<br />ものづくりを支える<br />パートナーの皆さま。</p>
    </header>

    <div class="sponsor-tiers">
      {sponsorTiers.map((tier) => (
        <section class={`sponsor-tier sponsor-tier--${tier.id}`} aria-labelledby={`${tier.id}-heading`}>
          <header class="sponsor-tier-heading">
            <div>
              <p class="section-label">{tier.labelEn}</p>
              <h2 id={`${tier.id}-heading`}>{tier.label}</h2>
            </div>
            <p class="sponsor-count"><strong>{tier.sponsors.length}</strong><span>社</span></p>
          </header>

          <ul class="sponsor-grid">
            {tier.sponsors.map((sponsor) => (
              <li class:list={{ 'sponsor-has-logo': Boolean(sponsor.logo) }}>
                {sponsor.website ? (
                  <a href={sponsor.website} target="_blank" rel="noreferrer">
                    {sponsor.logo && <img src={sponsor.logo} alt={sponsor.logoAlt || sponsor.name} />}
                    <strong>{sponsor.name}</strong>
                  </a>
                ) : (
                  <>
                    {sponsor.logo && <img src={sponsor.logo} alt={sponsor.logoAlt || sponsor.name} />}
                    <strong>{sponsor.name}</strong>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</WireframeLayout>
